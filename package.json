{
  "name": "ollama-chat",
  "version": "1.0.0",
  "description": "A local web chat UI for Ollama models",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "lint": "eslint .",
    "electron": "electron electron/main.js",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "express": "^4.19.2"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.8.1",
    "globals": "^17.11.0"
  },
  "build": {
    "appId": "com.ollamachat.app",
    "productName": "Ollama Chat",
    "files": [
      "electron/**/*",
      "server.js",
      "auth.js",
      "compaction.js",
      "db.js",
      "embeddings.js",
      "logger.js",
      "metrics.js",
      "qdrant.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": "nsis"
    }
  }
}
